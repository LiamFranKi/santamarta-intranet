<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{titulo}}</title>
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; width: 100%; }
    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      color: #1f2937;
      background: #f1f5f9;
      padding: 0;
    }
    @page { size: A4; margin: 10mm; }

    .sheet {
      width: 100%;
      max-width: none;
      margin: 0 0 0 0;
      background: #fff;
      border: 2px solid #a7f3d0;
      border-radius: 0;
      padding: 14px 16px 10px;
      display: flex;
      flex-direction: column;
      min-height: 268mm;
    }
    .sheet-body { flex: 1 1 auto; width: 100%; }
    .page-break {
      page-break-before: always;
      break-before: page;
    }

    .header {
      display: grid;
      grid-template-columns: 52px minmax(0, 1fr) 110px;
      gap: 10px;
      align-items: center;
      margin-bottom: 12px;
      padding-bottom: 10px;
      border-bottom: 1px solid #e5e7eb;
    }
    .unidad-badge {
      background: linear-gradient(135deg, #059669, #2563eb);
      color: #fff;
      font-weight: 800;
      font-size: 26px;
      width: 52px;
      height: 52px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .titulo-principal { margin: 0; font-size: 17px; line-height: 1.3; color: #047857; text-transform: uppercase; }
    .subtitulo { margin: 4px 0 0; font-size: 10px; color: #6b7280; line-height: 1.4; }
    .logo-wrap { text-align: right; }
    .logo { max-height: 46px; max-width: 110px; object-fit: contain; }
    .logo-text { font-weight: 800; color: #1d4ed8; font-size: 13px; text-align: right; }

    .seccion-titulo {
      margin: 0 0 10px;
      font-size: 14px;
      color: #047857;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      border-left: 4px solid #059669;
      padding-left: 10px;
    }

    .parrafo-teoria {
      display: flex;
      flex-direction: row;
      align-items: flex-end;
      gap: 10px;
      width: 100%;
      margin: 0 0 10px;
      padding: 11px 12px;
      border-radius: 10px;
      font-size: 12px;
      line-height: 1.65;
      text-align: justify;
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .parrafo-texto { flex: 1 1 auto; min-width: 0; }
    .caja-verde { background: linear-gradient(135deg, #f0fdf4, #ecfdf5); border: 2px solid #86efac; }
    .caja-azul { background: linear-gradient(135deg, #eff6ff, #dbeafe); border: 2px solid #93c5fd; }
    .caja-amarilla { background: linear-gradient(135deg, #fffbeb, #fef3c7); border: 2px solid #fcd34d; }
    .caja-lila { background: linear-gradient(135deg, #faf5ff, #f3e8ff); border: 2px solid #d8b4fe; }
    .caja-coral { background: linear-gradient(135deg, #fff7ed, #ffedd5); border: 2px solid #fdba74; }

    .mascota-inline {
      flex: 0 0 64px;
      width: 64px;
      text-align: center;
    }
    .mascota-inline img {
      display: block;
      width: 64px;
      max-height: 72px;
      object-fit: contain;
      margin: 0 auto;
    }

    .ilustraciones-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin: 10px 0 12px;
      width: 100%;
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .ilustracion-card {
      border: 2px solid #a7f3d0;
      border-radius: 10px;
      padding: 8px 10px;
      background: #fff;
    }
    .ilustracion-emoji { font-size: 28px; text-align: center; margin-bottom: 4px; }
    .ilustracion-card h4 { margin: 0 0 4px; font-size: 10px; color: #047857; text-align: center; }
    .ilustracion-card p { margin: 0; font-size: 9.5px; line-height: 1.45; text-align: justify; }

    .glosario-box {
      margin: 8px 0 10px;
      padding: 10px 12px;
      background: #fffbeb;
      border: 2px solid #fcd34d;
      border-radius: 10px;
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .glosario-box h3 { margin: 0 0 8px; font-size: 12px; color: #b45309; }
    .glosario-item { margin: 0 0 6px; font-size: 10.5px; line-height: 1.45; }
    .glosario-item strong { color: #92400e; }

    .recuerda-box {
      background: #eff6ff;
      border: 2px solid #93c5fd;
      border-radius: 10px;
      padding: 10px;
      margin-top: 6px;
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .recuerda-box h3 { margin: 0 0 6px; font-size: 12px; color: #1d4ed8; }
    .recuerda-inner { display: flex; gap: 8px; align-items: flex-end; }
    .recuerda-box ul { flex: 1; margin: 0; padding-left: 16px; font-size: 11px; color: #1e3a8a; }

    .aplicacion-banner {
      background: linear-gradient(90deg, #ecfdf5, #eff6ff);
      border: 2px solid #6ee7b7;
      border-radius: 10px;
      padding: 12px 14px;
      margin-bottom: 12px;
      text-align: center;
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .aplicacion-banner h2 { margin: 0 0 6px; font-size: 16px; color: #047857; letter-spacing: 0.04em; }
    .aplicacion-banner p { margin: 0; font-size: 11px; color: #4b5563; }

    .actividad {
      margin-bottom: 10px;
      border-radius: 10px;
      padding: 12px;
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .act-verde { background: #f0fdf4; border: 2px solid #86efac; }
    .act-azul { background: #eff6ff; border: 2px solid #93c5fd; }
    .act-amarilla { background: #fffbeb; border: 2px solid #fcd34d; }
    .act-lila { background: #faf5ff; border: 2px solid #d8b4fe; }
    .act-coral { background: #fff7ed; border: 2px solid #fdba74; }
    .act-mint { background: #ecfdf5; border: 2px solid #6ee7b7; }

    .actividad-layout { display: flex; gap: 10px; align-items: flex-start; width: 100%; }
    .actividad-body { flex: 1; min-width: 0; }
    .actividad h4 { margin: 0 0 8px; color: #065f46; font-size: 13px; }
    .actividad p.inst { margin: 0 0 8px; font-size: 11px; color: #6b7280; }
    table { width: 100%; border-collapse: collapse; font-size: 11px; }
    th, td { border: 1px solid #d1d5db; padding: 6px 8px; background: #fff; }
    th { background: #ecfdf5; color: #065f46; }
    .pregunta { margin: 8px 0 0; font-size: 11px; line-height: 1.4; }
    .linea-resp { border-bottom: 1px solid #9ca3af; height: 20px; margin: 4px 0 8px; }

    .pie {
      margin-top: 10px;
      text-align: center;
      background: #fef3c7;
      border: 1px solid #fcd34d;
      border-radius: 8px;
      padding: 10px;
      font-size: 12px;
      font-weight: 600;
      color: #92400e;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .footer-meta {
      margin-top: auto;
      padding-top: 10px;
      border-top: 1px solid #e5e7eb;
      display: flex;
      justify-content: space-between;
      font-size: 9px;
      color: #9ca3af;
      flex-shrink: 0;
    }

    @media print {
      body { background: #fff; padding: 0; }
      .sheet {
        border: none;
        min-height: 268mm;
        page-break-after: always;
      }
      .hoja-aplicacion.sheet { page-break-after: auto; }
      .page-break { page-break-before: always; }
      .parrafo-teoria, .glosario-box, .recuerda-box, .actividad, .ilustraciones-grid, .aplicacion-banner {
        break-inside: avoid;
        page-break-inside: avoid;
      }
    }
  </style>
</head>
<body>
  <!-- HOJA 1: TEORÍA -->
  <div class="sheet hoja-teoria">
    <div class="sheet-body">
      <div class="header">
        <div class="unidad-badge">{{unidad}}</div>
        <div>
          <h1 class="titulo-principal">{{titulo}}</h1>
          <p class="subtitulo">{{subtituloLinea}}</p>
        </div>
        <div class="logo-wrap">
          {{#if tieneLogo}}<img class="logo" src="{{logoUrl}}" alt="Vanguard" />{{else}}<div class="logo-text">VANGUARD<br/>Schools</div>{{/if}}
        </div>
      </div>

      <h2 class="seccion-titulo">{{teoria.titulo_seccion}}</h2>

      {{#each teoria.parrafos}}
      <div class="parrafo-teoria {{estilo}}">
        <div class="parrafo-texto">{{texto}}</div>
        {{#if mascotaUrl}}
        <div class="mascota-inline"><img src="{{mascotaUrl}}" alt="" /></div>
        {{/if}}
      </div>
      {{/each}}

      {{#if teoria.ilustraciones}}
      <div class="ilustraciones-grid">
        {{#each teoria.ilustraciones}}
        <div class="ilustracion-card">
          <div class="ilustracion-emoji">{{emoji}}</div>
          <h4>{{titulo}}</h4>
          <p>{{descripcion}}</p>
        </div>
        {{/each}}
      </div>
      {{/if}}

      {{#if teoria.glosario}}
      <div class="glosario-box">
        <h3>📖 Palabras importantes</h3>
        {{#each teoria.glosario}}
        <p class="glosario-item"><strong>{{termino}}:</strong> {{definicion}}</p>
        {{/each}}
      </div>
      {{/if}}

      <div class="recuerda-box">
        <h3>💡 RECUERDA</h3>
        <div class="recuerda-inner">
          <ul>
            {{#each teoria.recuerda}}
            <li>{{this}}</li>
            {{/each}}
          </ul>
          {{#if mascotaRecuerdaUrl}}
          <div class="mascota-inline"><img src="{{mascotaRecuerdaUrl}}" alt="" /></div>
          {{/if}}
        </div>
      </div>
    </div>

    <div class="footer-meta">
      <span>{{area}} · Teoría</span>
      <span>Vanguard Schools</span>
    </div>
  </div>

  <!-- HOJA 2: APLICACIÓN -->
  <div class="sheet hoja-aplicacion page-break">
    <div class="sheet-body">
      <div class="aplicacion-banner">
        <h2>{{aplicacion.titulo_seccion}}</h2>
        {{#if aplicacion.instruccion_general}}
        <p>{{aplicacion.instruccion_general}}</p>
        {{/if}}
      </div>

      {{#each actividades}}
      <div class="actividad {{estilo}}">
        <div class="actividad-layout">
          <div class="actividad-body">
            <h4>{{titulo}}</h4>
            {{#if instruccion}}<p class="inst">{{instruccion}}</p>{{/if}}
            {{#if (eq tipo "tabla_partes")}}
            <table>
              <thead><tr>{{#each columnas}}<th>{{this}}</th>{{/each}}</tr></thead>
              <tbody>
                {{#each filas}}
                <tr>
                  <td>{{parte}}</td>
                  <td>{{#if funcion}}{{funcion}}{{else}}<span style="color:#9ca3af">________________</span>{{/if}}</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
            {{/if}}
            {{#if (eq tipo "preguntas")}}
            {{#each preguntas}}
            <div class="pregunta"><strong>{{add @index 1}}.</strong> {{this}}</div>
            <div class="linea-resp"></div>
            {{/each}}
            {{/if}}
          </div>
          {{#if mascotaUrl}}
          <div class="mascota-inline"><img src="{{mascotaUrl}}" alt="" /></div>
          {{/if}}
        </div>
      </div>
      {{/each}}

      {{#if pie_motivacional}}
      <div class="pie">{{pie_motivacional}}</div>
      {{/if}}
    </div>

    <div class="footer-meta">
      <span>{{area}}</span>
      {{#if usoVanguarcito}}
      <span>Contenido estructurado por Vanguarcito</span>
      {{else}}
      <span>Ficha Vanguard Schools</span>
      {{/if}}
    </div>
  </div>
</body>
</html>
