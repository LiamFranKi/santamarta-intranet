<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>{{titulo}}</title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: 'Segoe UI', Arial, sans-serif; margin: 0; padding: 16px; color: #1f2937; background: #f8fafc; }
    .sheet { max-width: 900px; margin: 0 auto; background: #fff; border: 2px solid #a7f3d0; border-radius: 12px; padding: 20px 24px; }
    .header { display: grid; grid-template-columns: 56px 1fr 120px; gap: 12px; align-items: center; margin-bottom: 16px; }
    .unidad-badge { background: linear-gradient(135deg, #059669, #2563eb); color: #fff; font-weight: 800; font-size: 28px; width: 56px; height: 56px; border-radius: 10px; display: flex; align-items: center; justify-content: center; }
    .titulo-principal { margin: 0; font-size: 18px; line-height: 1.25; color: #047857; text-transform: uppercase; }
    .subtitulo { margin: 4px 0 0; font-size: 11px; color: #6b7280; }
    .logo { max-height: 48px; max-width: 120px; object-fit: contain; }
    .logo-text { font-weight: 800; color: #1d4ed8; font-size: 14px; text-align: right; }
    .intro-row { display: grid; grid-template-columns: 1fr 280px; gap: 14px; margin-bottom: 16px; align-items: start; }
    .intro-main { display: flex; gap: 10px; align-items: flex-end; }
    .intro-text { flex: 1; font-size: 12px; line-height: 1.5; background: #f0fdf4; border-radius: 8px; padding: 12px; border: 1px solid #bbf7d0; }
    .intro-mascotas { display: flex; gap: 6px; flex-shrink: 0; align-items: flex-end; }
    .intro-mascotas .mascota { height: 88px; width: auto; max-width: 72px; object-fit: contain; }
    .recuerda { background: #eff6ff; border: 2px solid #93c5fd; border-radius: 10px; padding: 10px 12px; }
    .recuerda h3 { margin: 0 0 8px; font-size: 13px; color: #1d4ed8; display: flex; align-items: center; gap: 6px; }
    .recuerda ul { margin: 0; padding-left: 18px; font-size: 11px; color: #1e3a8a; }
    .actividad { margin-bottom: 14px; border: 1px solid #e5e7eb; border-radius: 8px; padding: 12px; }
    .actividad h4 { margin: 0 0 8px; color: #047857; font-size: 13px; }
    .actividad p.inst { margin: 0 0 8px; font-size: 11px; color: #6b7280; }
    table { width: 100%; border-collapse: collapse; font-size: 11px; }
    th, td { border: 1px solid #d1d5db; padding: 6px 8px; text-align: left; }
    th { background: #ecfdf5; color: #065f46; }
    .pregunta { margin: 8px 0; font-size: 11px; }
    .linea-resp { border-bottom: 1px solid #9ca3af; height: 18px; margin-top: 4px; }
    .pie { margin-top: 16px; text-align: center; background: #fef3c7; border: 1px solid #fcd34d; border-radius: 8px; padding: 10px; font-size: 12px; font-weight: 600; color: #92400e; }
    .footer-meta { margin-top: 12px; display: flex; justify-content: space-between; font-size: 10px; color: #6b7280; }
    @media print { body { background: #fff; } .sheet { border: none; } }
  </style>
</head>
<body>
  <div class="sheet">
    <div class="header">
      <div class="unidad-badge">{{unidad}}</div>
      <div>
        <h1 class="titulo-principal">{{titulo}}</h1>
        <p class="subtitulo">{{grado}}.º grado · {{area}} · Vanguard Schools · {{anio}}</p>
      </div>
      <div>
        {{#if tieneLogo}}<img class="logo" src="{{logoUrl}}" alt="Vanguard" />{{else}}<div class="logo-text">VANGUARD<br/>Schools</div>{{/if}}
      </div>
    </div>

    <div class="intro-row">
      <div class="intro-main">
        <div class="intro-text">{{intro}}</div>
        {{#if mascotas.length}}
        <div class="intro-mascotas" aria-hidden="true">
          {{#each mascotas}}
          <img class="mascota" src="{{url}}" alt="" />
          {{/each}}
        </div>
        {{/if}}
      </div>
      <div class="recuerda">
        <h3>💡 RECUERDA</h3>
        <ul>
          {{#each recuerda}}
          <li>{{this}}</li>
          {{/each}}
        </ul>
      </div>
    </div>

    {{#each actividades}}
    <div class="actividad">
      <h4>{{titulo}}</h4>
      {{#if instruccion}}<p class="inst">{{instruccion}}</p>{{/if}}
      {{#if (eq tipo "tabla_partes")}}
      <table>
        <thead>
          <tr>
            {{#each columnas}}<th>{{this}}</th>{{/each}}
          </tr>
        </thead>
        <tbody>
          {{#each filas}}
          <tr>
            <td>{{parte}}</td>
            <td>{{#if funcion}}{{funcion}}{{else}}<span style="color:#9ca3af">________________</span>{{/if}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{/if}}
      {{#if (eq tipo "preguntas")}}
      {{#each preguntas}}
      <div class="pregunta"><strong>{{add @index 1}}.</strong> {{this}}</div>
      <div class="linea-resp"></div>
      {{/each}}
      {{/if}}
    </div>
    {{/each}}

    {{#if pie_motivacional}}
    <div class="pie">{{pie_motivacional}}</div>
    {{/if}}

    <div class="footer-meta">
      <span>{{area}}</span>
      <span>Generado con Vanguarcito · Vanguard Schools</span>
    </div>
  </div>
</body>
</html>
