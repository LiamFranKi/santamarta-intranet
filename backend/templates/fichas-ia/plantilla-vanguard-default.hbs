<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{titulo}}</title>
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      color: #1f2937;
      background: #f1f5f9;
      padding: 12px;
    }
    .sheet {
      width: 100%;
      max-width: 820px;
      margin: 0 auto;
      background: #fff;
      border: 2px solid #a7f3d0;
      border-radius: 12px;
      padding: 18px 20px 14px;
    }
    .header {
      display: grid;
      grid-template-columns: 52px minmax(0, 1fr) 110px;
      gap: 10px;
      align-items: center;
      margin-bottom: 14px;
      padding-bottom: 12px;
      border-bottom: 1px solid #e5e7eb;
    }
    .unidad-badge {
      background: linear-gradient(135deg, #059669, #2563eb);
      color: #fff;
      font-weight: 800;
      font-size: 26px;
      width: 52px;
      height: 52px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .titulo-principal {
      margin: 0;
      font-size: 17px;
      line-height: 1.3;
      color: #047857;
      text-transform: uppercase;
      word-wrap: break-word;
    }
    .subtitulo { margin: 4px 0 0; font-size: 10px; color: #6b7280; line-height: 1.4; }
    .logo-wrap { text-align: right; }
    .logo { max-height: 46px; max-width: 110px; object-fit: contain; display: inline-block; }
    .logo-text { font-weight: 800; color: #1d4ed8; font-size: 13px; text-align: right; line-height: 1.2; }

    .intro-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 200px;
      gap: 12px;
      margin-bottom: 14px;
      align-items: stretch;
    }
    .intro-wrap {
      display: flex;
      flex-direction: row;
      align-items: flex-end;
      gap: 10px;
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      border-radius: 8px;
      padding: 12px;
      min-height: 88px;
    }
    .intro-text {
      flex: 1;
      min-width: 0;
      font-size: 12px;
      line-height: 1.55;
      text-align: justify;
      word-wrap: break-word;
      overflow-wrap: break-word;
    }
    .mascota-slot {
      flex: 0 0 68px;
      width: 68px;
      text-align: center;
    }
    .mascota-slot img {
      display: block;
      width: 68px;
      height: auto;
      max-height: 76px;
      object-fit: contain;
      margin: 0 auto;
    }

    .recuerda-box {
      display: flex;
      flex-direction: column;
      background: #eff6ff;
      border: 2px solid #93c5fd;
      border-radius: 10px;
      padding: 10px;
      min-height: 88px;
    }
    .recuerda-box h3 {
      margin: 0 0 6px;
      font-size: 12px;
      color: #1d4ed8;
    }
    .recuerda-inner {
      display: flex;
      flex-direction: row;
      align-items: flex-end;
      gap: 6px;
      flex: 1;
    }
    .recuerda-box ul {
      flex: 1;
      min-width: 0;
      margin: 0;
      padding-left: 16px;
      font-size: 10px;
      color: #1e3a8a;
      line-height: 1.45;
    }

    .actividad {
      margin-bottom: 12px;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 12px;
      overflow: hidden;
    }
    .actividad-layout {
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      gap: 12px;
    }
    .actividad-body { flex: 1; min-width: 0; }
    .actividad h4 { margin: 0 0 8px; color: #047857; font-size: 13px; }
    .actividad p.inst { margin: 0 0 8px; font-size: 11px; color: #6b7280; }
    table { width: 100%; border-collapse: collapse; font-size: 11px; }
    th, td { border: 1px solid #d1d5db; padding: 6px 8px; text-align: left; }
    th { background: #ecfdf5; color: #065f46; }
    .pregunta { margin: 8px 0 0; font-size: 11px; line-height: 1.4; }
    .linea-resp {
      border-bottom: 1px solid #9ca3af;
      height: 20px;
      margin-top: 4px;
      margin-bottom: 4px;
    }

    .pie {
      margin-top: 12px;
      text-align: center;
      background: #fef3c7;
      border: 1px solid #fcd34d;
      border-radius: 8px;
      padding: 10px 12px;
      font-size: 12px;
      font-weight: 600;
      color: #92400e;
      clear: both;
    }
    .footer-meta {
      margin-top: 10px;
      padding-top: 8px;
      border-top: 1px solid #e5e7eb;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 9px;
      color: #9ca3af;
      gap: 8px;
      clear: both;
    }
    .footer-meta span { flex: 0 1 auto; }

    @media (max-width: 640px) {
      .intro-row { grid-template-columns: 1fr; }
      .header { grid-template-columns: 48px 1fr; }
      .logo-wrap { grid-column: 1 / -1; text-align: left; margin-top: 6px; }
    }
    @media print {
      body { background: #fff; padding: 0; }
      .sheet { border: none; max-width: 100%; }
    }
  </style>
</head>
<body>
  <div class="sheet">
    <div class="header">
      <div class="unidad-badge">{{unidad}}</div>
      <div>
        <h1 class="titulo-principal">{{titulo}}</h1>
        <p class="subtitulo">{{subtituloLinea}}</p>
      </div>
      <div class="logo-wrap">
        {{#if tieneLogo}}<img class="logo" src="{{logoUrl}}" alt="Vanguard" width="110" height="46" />{{else}}<div class="logo-text">VANGUARD<br/>Schools</div>{{/if}}
      </div>
    </div>

    <div class="intro-row">
      <div class="intro-wrap">
        <div class="intro-text">{{intro}}</div>
        {{#if mascotaIntroUrl}}
        <div class="mascota-slot"><img src="{{mascotaIntroUrl}}" alt="" width="68" height="76" /></div>
        {{/if}}
      </div>
      <div class="recuerda-box">
        <h3>💡 RECUERDA</h3>
        <div class="recuerda-inner">
          <ul>
            {{#each recuerda}}
            <li>{{this}}</li>
            {{/each}}
          </ul>
          {{#if mascotaRecuerdaUrl}}
          <div class="mascota-slot"><img src="{{mascotaRecuerdaUrl}}" alt="" width="68" height="64" /></div>
          {{/if}}
        </div>
      </div>
    </div>

    {{#each actividades}}
    <div class="actividad">
      <div class="actividad-layout">
        <div class="actividad-body">
          <h4>{{titulo}}</h4>
          {{#if instruccion}}<p class="inst">{{instruccion}}</p>{{/if}}
          {{#if (eq tipo "tabla_partes")}}
          <table>
            <thead>
              <tr>
                {{#each columnas}}<th>{{this}}</th>{{/each}}
              </tr>
            </thead>
            <tbody>
              {{#each filas}}
              <tr>
                <td>{{parte}}</td>
                <td>{{#if funcion}}{{funcion}}{{else}}<span style="color:#9ca3af">________________</span>{{/if}}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
          {{/if}}
          {{#if (eq tipo "preguntas")}}
          {{#each preguntas}}
          <div class="pregunta"><strong>{{add @index 1}}.</strong> {{this}}</div>
          <div class="linea-resp"></div>
          {{/each}}
          {{/if}}
        </div>
        {{#if mascotaUrl}}
        <div class="mascota-slot"><img src="{{mascotaUrl}}" alt="" width="68" height="68" /></div>
        {{/if}}
      </div>
    </div>
    {{/each}}

    {{#if pie_motivacional}}
    <div class="pie">{{pie_motivacional}}</div>
    {{/if}}

    <div class="footer-meta">
      <span>{{area}}</span>
      {{#if usoVanguarcito}}
      <span>Contenido estructurado por Vanguarcito</span>
      {{else}}
      <span>Ficha Vanguard Schools</span>
      {{/if}}
    </div>
  </div>
</body>
</html>
