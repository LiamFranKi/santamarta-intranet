<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>{{titulo}}</title>
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; width: 100%; }
    body { font-family: 'Segoe UI', Arial, sans-serif; color: #1e293b; background: #fff; }
    @page { size: A4; margin: 9mm; }

    .sheet {
      width: 100%;
      min-height: 268mm;
      display: flex;
      flex-direction: column;
      box-sizing: border-box;
      background: #fff;
      border: 3px solid #059669;
      padding: 0;
      overflow: visible;
      page-break-after: always;
      break-after: page;
    }
    .sheet-top-band {
      flex: 0 0 auto;
      height: 6px;
      background: linear-gradient(90deg, #059669 0%, #2563eb 50%, #059669 100%);
    }
    .sheet-inner {
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      min-height: calc(268mm - 6px);
      padding: 12px 14px 10px;
      box-sizing: border-box;
    }
    .sheet-body {
      flex: 0 1 auto;
      width: 100%;
    }
    .sheet-footer-zone {
      flex: 0 0 auto;
      width: 100%;
      margin-top: auto;
      padding-top: 14px;
      break-inside: avoid;
      page-break-inside: avoid;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .page-break { page-break-before: always; break-before: page; }

    .header {
      display: grid;
      grid-template-columns: 54px 1fr 108px;
      gap: 10px;
      align-items: center;
      margin-bottom: 14px;
      padding: 10px 12px;
      background: linear-gradient(135deg, #ecfdf5 0%, #eff6ff 100%);
      border-radius: 12px;
      border: 1px solid #a7f3d0;
    }
    .unidad-badge {
      background: linear-gradient(145deg, #047857, #1d4ed8);
      color: #fff;
      font-weight: 800;
      font-size: 24px;
      width: 54px;
      height: 54px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 6px rgba(5, 150, 105, 0.35);
    }
    .titulo-principal {
      margin: 0;
      font-size: 18px;
      line-height: 1.25;
      color: #047857;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .subtitulo { margin: 5px 0 0; font-size: 9.5px; color: #64748b; }
    .logo { max-height: 48px; max-width: 108px; object-fit: contain; }
    .logo-text { font-weight: 800; color: #1d4ed8; font-size: 12px; text-align: right; line-height: 1.2; }

    .seccion-titulo-wrap {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 0 0 12px;
      padding: 8px 12px;
      background: #047857;
      border-radius: 10px;
      color: #fff;
    }
    .seccion-titulo-wrap span.icon { font-size: 18px; }
    .seccion-titulo-wrap h2 {
      margin: 0;
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .parrafo-teoria {
      display: flex;
      align-items: flex-end;
      gap: 10px;
      width: 100%;
      margin: 0 0 9px;
      padding: 10px 12px 10px 10px;
      border-radius: 11px;
      font-size: 11.5px;
      line-height: 1.62;
      text-align: justify;
      break-inside: avoid;
      page-break-inside: avoid;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
    }
    .parrafo-num {
      flex: 0 0 26px;
      width: 26px;
      height: 26px;
      border-radius: 8px;
      background: #047857;
      color: #fff;
      font-weight: 800;
      font-size: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      align-self: flex-start;
      margin-top: 2px;
    }
    .parrafo-texto { flex: 1; min-width: 0; }
    .caja-verde { background: linear-gradient(135deg, #f0fdf4, #dcfce7); border-left: 5px solid #22c55e; }
    .caja-azul { background: linear-gradient(135deg, #eff6ff, #dbeafe); border-left: 5px solid #3b82f6; }
    .caja-amarilla { background: linear-gradient(135deg, #fffbeb, #fef9c3); border-left: 5px solid #eab308; }
    .caja-lila { background: linear-gradient(135deg, #faf5ff, #ede9fe); border-left: 5px solid #a855f7; }
    .caja-coral { background: linear-gradient(135deg, #fff7ed, #ffedd5); border-left: 5px solid #f97316; }

    .mascota-inline { flex: 0 0 62px; }
    .mascota-inline img { width: 62px; max-height: 70px; object-fit: contain; display: block; }

    .ilustraciones-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin: 10px 0;
      break-inside: avoid;
    }
    .ilustracion-card {
      border-radius: 10px;
      padding: 8px;
      text-align: center;
      border: 2px solid #86efac;
      background: #fff;
    }
    .ilustracion-emoji { font-size: 26px; margin-bottom: 4px; }
    .ilustracion-card h4 { margin: 0 0 4px; font-size: 9.5px; color: #047857; text-transform: uppercase; }
    .ilustracion-card p { margin: 0; font-size: 9px; line-height: 1.4; text-align: justify; color: #475569; }

    .glosario-box {
      margin: 8px 0;
      padding: 10px 12px;
      background: linear-gradient(180deg, #fffbeb, #fff);
      border: 2px solid #fbbf24;
      border-radius: 11px;
      break-inside: avoid;
    }
    .glosario-box h3 { margin: 0 0 8px; font-size: 12px; color: #b45309; }
    .glosario-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 12px; }
    .glosario-item { margin: 0; font-size: 10px; line-height: 1.4; }
    .glosario-item strong { color: #92400e; }

    .recuerda-box {
      background: linear-gradient(135deg, #eff6ff, #e0f2fe);
      border: 2px solid #60a5fa;
      border-radius: 11px;
      padding: 10px 12px;
      break-inside: avoid;
    }
    .recuerda-box h3 { margin: 0 0 8px; font-size: 12px; color: #1d4ed8; }
    .recuerda-inner { display: flex; gap: 8px; align-items: flex-end; }
    .recuerda-box ul { flex: 1; margin: 0; padding-left: 18px; font-size: 10.5px; color: #1e3a8a; }
    .recuerda-box li { margin-bottom: 4px; }

    .aplicacion-banner {
      background: linear-gradient(90deg, #047857, #059669);
      color: #fff;
      border-radius: 11px;
      padding: 12px 14px;
      margin-bottom: 12px;
      text-align: center;
      break-inside: avoid;
    }
    .aplicacion-banner h2 { margin: 0 0 6px; font-size: 15px; letter-spacing: 0.06em; }
    .aplicacion-banner p { margin: 0; font-size: 10.5px; opacity: 0.95; }

    .actividad {
      margin-bottom: 11px;
      border-radius: 11px;
      padding: 11px 12px;
      break-inside: avoid;
      page-break-inside: avoid;
      box-shadow: 0 1px 4px rgba(15, 23, 42, 0.07);
    }
    .act-verde { background: #f0fdf4; border: 2px solid #4ade80; }
    .act-azul { background: #eff6ff; border: 2px solid #60a5fa; }
    .act-amarilla { background: #fffbeb; border: 2px solid #facc15; }
    .act-lila { background: #faf5ff; border: 2px solid #c084fc; }
    .act-coral { background: #fff7ed; border: 2px solid #fb923c; }
    .act-mint { background: #ecfdf5; border: 2px solid #34d399; }

    .actividad h4 {
      margin: 0 0 8px;
      font-size: 12.5px;
      color: #065f46;
      padding-bottom: 6px;
      border-bottom: 1px dashed rgba(5, 150, 105, 0.35);
    }
    .actividad p.inst { margin: 0 0 8px; font-size: 10.5px; color: #64748b; font-style: italic; }

    .pregunta-block { margin: 10px 0 0; }
    .pregunta-texto { font-size: 11px; line-height: 1.45; margin: 0 0 4px; }
    .pregunta-texto strong { color: #047857; }
    .linea-resp {
      border-bottom: 2px solid #94a3b8;
      height: 22px;
      margin: 2px 0 10px;
    }

    .caja-dibujo {
      margin-top: 8px;
      border: 2px dashed #64748b;
      border-radius: 10px;
      background: #fff;
      min-height: 120px;
      position: relative;
    }
    .caja-dibujo-label {
      position: absolute;
      bottom: 6px;
      right: 10px;
      font-size: 8px;
      color: #94a3b8;
    }

    table { width: 100%; border-collapse: collapse; font-size: 10.5px; margin-top: 6px; }
    th, td { border: 1.5px solid #cbd5e1; padding: 7px 8px; background: #fff; }
    th { background: #d1fae5; color: #065f46; font-weight: 700; }

    .tabla-vf { margin-top: 6px; }
    .tabla-vf th { text-align: center; }
    .tabla-vf .vf-col { width: 42px; text-align: center; }
    .tabla-vf td.enunciado { text-align: left; font-size: 10.5px; }
    .tabla-vf td.casillero {
      text-align: center;
      font-size: 14px;
      font-weight: 700;
      color: #cbd5e1;
      letter-spacing: 4px;
    }

    .item-opciones { margin: 10px 0 0; }
    .item-opciones-letra {
      font-size: 11px;
      line-height: 1.45;
      margin: 0 0 6px;
    }
    .item-opciones-letra strong.letra-g {
      display: inline-block;
      min-width: 22px;
      color: #047857;
      font-size: 12px;
    }
    .subopciones-list { margin: 4px 0 8px 20px; padding: 0; list-style: none; }
    .subopciones-list li { margin: 5px 0; font-size: 10.5px; }
    .subopciones-list strong { color: #2563eb; margin-right: 4px; }
    .linea-marca {
      display: inline-block;
      min-width: 80px;
      border-bottom: 2px solid #94a3b8;
      margin-left: 6px;
      vertical-align: bottom;
      height: 14px;
    }

    .oracion-completar {
      font-size: 11px;
      line-height: 1.8;
      margin: 8px 0;
    }
    .hueco {
      display: inline-block;
      min-width: 90px;
      border-bottom: 2px solid #64748b;
      margin: 0 4px;
    }

    .pie {
      margin: 0 0 8px;
      text-align: center;
      background: linear-gradient(90deg, #fef3c7, #fde68a);
      border: 2px solid #fbbf24;
      border-radius: 10px;
      padding: 10px 12px;
      font-size: 11.5px;
      font-weight: 600;
      color: #92400e;
      line-height: 1.45;
      break-inside: avoid;
    }

    .footer-meta {
      margin-top: 0;
      padding: 8px 0 4px;
      border-top: 2px solid #e2e8f0;
      display: flex;
      justify-content: space-between;
      font-size: 8.5px;
      color: #94a3b8;
      flex-shrink: 0;
    }

    @media print {
      .sheet {
        border: none;
        min-height: 268mm;
        height: auto !important;
        max-height: none !important;
        overflow: visible !important;
        page-break-after: always;
      }
      .hoja-aplicacion.sheet { page-break-after: auto; }
      .sheet-inner {
        min-height: calc(268mm - 6mm);
        height: auto !important;
      }
      .sheet-footer-zone {
        position: static !important;
        margin-top: auto;
      }
      .parrafo-teoria, .glosario-box, .recuerda-box, .actividad, .ilustraciones-grid, .aplicacion-banner, .pie, .sheet-footer-zone {
        break-inside: avoid;
        page-break-inside: avoid;
      }
      .caja-dibujo { break-inside: avoid; page-break-inside: avoid; }
      .tabla-vf tr { break-inside: avoid; page-break-inside: avoid; }
    }
  </style>
</head>
<body>
  <div class="sheet hoja-teoria">
    <div class="sheet-top-band"></div>
    <div class="sheet-inner">
      <div class="sheet-body">
        <div class="header">
          <div class="unidad-badge">{{unidad}}</div>
          <div>
            <h1 class="titulo-principal">{{titulo}}</h1>
            <p class="subtitulo">{{subtituloLinea}}</p>
          </div>
          <div style="text-align:right">
            {{#if tieneLogo}}<img class="logo" src="{{logoUrl}}" alt="Vanguard" />{{else}}<div class="logo-text">VANGUARD<br/>Schools</div>{{/if}}
          </div>
        </div>

        <div class="seccion-titulo-wrap">
          <span class="icon">📚</span>
          <h2>{{teoria.titulo_seccion}}</h2>
        </div>

        {{#each teoria.parrafos}}
        <div class="parrafo-teoria {{estilo}}">
          <div class="parrafo-num">{{num}}</div>
          <div class="parrafo-texto">{{texto}}</div>
          {{#if mascotaUrl}}<div class="mascota-inline"><img src="{{mascotaUrl}}" alt="" /></div>{{/if}}
        </div>
        {{/each}}

        {{#if teoria.ilustraciones}}
        <div class="ilustraciones-grid">
          {{#each teoria.ilustraciones}}
          <div class="ilustracion-card">
            <div class="ilustracion-emoji">{{emoji}}</div>
            <h4>{{titulo}}</h4>
            <p>{{descripcion}}</p>
          </div>
          {{/each}}
        </div>
        {{/if}}

        {{#if teoria.glosario}}
        <div class="glosario-box">
          <h3>📖 Palabras importantes</h3>
          <div class="glosario-grid">
            {{#each teoria.glosario}}
            <p class="glosario-item"><strong>{{termino}}:</strong> {{definicion}}</p>
            {{/each}}
          </div>
        </div>
        {{/if}}

        <div class="recuerda-box">
          <h3>💡 RECUERDA</h3>
          <div class="recuerda-inner">
            <ul>
              {{#each teoria.recuerda}}<li>{{this}}</li>{{/each}}
            </ul>
            {{#if mascotaRecuerdaUrl}}<div class="mascota-inline"><img src="{{mascotaRecuerdaUrl}}" alt="" /></div>{{/if}}
          </div>
        </div>
      </div>
      <div class="sheet-footer-zone">
        <div class="footer-meta">
          <span>{{area}} · Teoría · Hoja 1</span>
          <span>Vanguard Schools</span>
        </div>
      </div>
    </div>
  </div>

  <div class="sheet hoja-aplicacion page-break">
    <div class="sheet-top-band"></div>
    <div class="sheet-inner">
      <div class="sheet-body">
        <div class="aplicacion-banner">
          <h2>{{aplicacion.titulo_seccion}}</h2>
          {{#if aplicacion.instruccion_general}}<p>{{aplicacion.instruccion_general}}</p>{{/if}}
        </div>

        {{#each actividades}}
        <div class="actividad {{estilo}}">
          <h4>{{titulo}}</h4>
          {{#if instruccion}}<p class="inst">{{instruccion}}</p>{{/if}}

          {{#if (eq tipo "tabla_partes")}}
          <table>
            <thead><tr>{{#each columnas}}<th>{{this}}</th>{{/each}}</tr></thead>
            <tbody>
              {{#each filas}}
              <tr><td>{{parte}}</td><td>{{#if funcion}}{{funcion}}{{else}}<span style="color:#94a3b8">____________________</span>{{/if}}</td></tr>
              {{/each}}
            </tbody>
          </table>
          {{/if}}

          {{#if (eq tipo "preguntas")}}
          {{#each preguntas}}
          <div class="pregunta-block">
            <p class="pregunta-texto"><strong>{{add @index 1}}.</strong> {{texto}}</p>
            <div class="linea-resp"></div>
          </div>
          {{/each}}
          {{/if}}

          {{#if (eq tipo "dibujo")}}
          <p class="inst" style="font-style:normal;color:#334155">{{instruccion_dibujo}}</p>
          <div class="caja-dibujo" style="min-height: {{altura_dibujo}}px">
            <span class="caja-dibujo-label">Espacio para tu dibujo en esta ficha</span>
          </div>
          {{/if}}

          {{#if (eq tipo "verdadero_falso")}}
          <table class="tabla-vf">
            <thead>
              <tr><th>Affirmación</th><th class="vf-col">V</th><th class="vf-col">F</th></tr>
            </thead>
            <tbody>
              {{#each items}}
              <tr>
                <td class="enunciado">{{enunciado}}</td>
                <td class="casillero">○</td>
                <td class="casillero">○</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
          {{/if}}

          {{#if (eq tipo "opciones")}}
          {{#each items}}
          <div class="item-opciones">
            <p class="item-opciones-letra"><strong class="letra-g">{{letra}})</strong> {{enunciado}}</p>
            {{#if subopciones}}
            <ul class="subopciones-list">
              {{#each subopciones}}
              <li><strong>{{letra}})</strong> {{texto}} <span class="linea-marca"></span></li>
              {{/each}}
            </ul>
            {{else}}
            <div class="linea-resp"></div>
            {{/if}}
          </div>
          {{/each}}
          {{/if}}

          {{#if (eq tipo "completar")}}
          {{#each oraciones}}
          <p class="oracion-completar">{{this}}</p>
          {{/each}}
          {{/if}}

          {{#if mascotaUrl}}
          <div style="text-align:right;margin-top:6px"><img src="{{mascotaUrl}}" alt="" style="width:56px;height:auto" /></div>
          {{/if}}
        </div>
        {{/each}}

      </div>
      <div class="sheet-footer-zone">
        <div class="pie">{{pie_motivacional}}</div>
        <div class="footer-meta">
          <span>{{area}} · Aplicación · Hoja 2</span>
          {{#if usoVanguarcito}}<span>{{nombreMascota}} · {{colegioNombre}}</span>{{else}}<span>{{colegioNombre}}</span>{{/if}}
        </div>
      </div>
    </div>
  </div>
</body>
</html>
