<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>{{titulo}}</title>
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; width: 100%; }
    body { font-family: 'Segoe UI', Arial, sans-serif; color: #1e293b; background: #fff; }
    @page { size: A4; margin: 9mm; }
    .sheet { width: 100%; min-height: 268mm; display: flex; flex-direction: column; background: #fff; border: 3px solid #1d4ed8; padding: 0 0 8px; }
    .sheet-top-band { height: 6px; background: linear-gradient(90deg, #1d4ed8 0%, #2563eb 50%, #1d4ed8 100%); }
    .sheet-inner { padding: 12px 14px 6px; flex: 1; display: flex; flex-direction: column; }
    .sheet-body { flex: 1 1 auto; width: 100%; }
    .page-break { page-break-before: always; break-before: page; }
    .header { display: grid; grid-template-columns: 54px 1fr 108px; gap: 10px; align-items: center; margin-bottom: 14px; padding: 10px 12px; background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border-radius: 12px; border: 1px solid #93c5fd; }
    .unidad-badge { background: linear-gradient(145deg, #1d4ed8, #2563eb); color: #fff; font-weight: 800; font-size: 24px; width: 54px; height: 54px; border-radius: 12px; display: flex; align-items: center; justify-content: center; }
    .titulo-principal { margin: 0; font-size: 18px; line-height: 1.25; color: #1d4ed8; text-transform: uppercase; letter-spacing: 0.03em; }
    .subtitulo { margin: 5px 0 0; font-size: 9.5px; color: #64748b; }
    .logo { max-height: 48px; max-width: 108px; object-fit: contain; }
    .logo-text { font-weight: 800; color: #1d4ed8; font-size: 12px; text-align: right; line-height: 1.2; }
    .seccion-titulo-wrap { display: flex; align-items: center; gap: 10px; margin: 0 0 12px; padding: 8px 12px; background: #1d4ed8; border-radius: 10px; color: #fff; }
    .seccion-titulo-wrap h2 { margin: 0; font-size: 13px; font-weight: 700; text-transform: uppercase; }
    .parrafo-teoria { display: flex; gap: 10px; margin: 0 0 9px; padding: 10px 12px; border-radius: 11px; font-size: 11.5px; line-height: 1.62; text-align: justify; break-inside: avoid; border-left: 5px solid #3b82f6; background: linear-gradient(135deg, #eff6ff, #dbeafe); }
    .parrafo-num { flex: 0 0 26px; width: 26px; height: 26px; border-radius: 8px; background: #1d4ed8; color: #fff; font-weight: 800; font-size: 12px; display: flex; align-items: center; justify-content: center; }
    .recuerda-box { margin: 10px 0; padding: 10px 12px; background: #fef9c3; border: 2px solid #eab308; border-radius: 10px; font-size: 11px; }
    .recuerda-box h3 { margin: 0 0 6px; font-size: 12px; color: #a16207; }
    .recuerda-box ul { margin: 0; padding-left: 18px; }
    .aplicacion-banner { background: linear-gradient(135deg, #1e3a8a, #2563eb); color: #fff; padding: 10px 14px; border-radius: 10px; margin-bottom: 12px; }
    .aplicacion-banner h2 { margin: 0 0 4px; font-size: 14px; text-transform: uppercase; }
    .aplicacion-banner p { margin: 0; font-size: 10.5px; opacity: 0.95; }
    .ejercicio-math { margin: 0 0 10px; padding: 8px 10px 10px; border-radius: 10px; border: 2px solid #bfdbfe; background: #f8fafc; break-inside: avoid; page-break-inside: avoid; }
    .ejercicio-math:nth-child(odd) { background: #f0f9ff; }
    .ej-num { display: inline-block; min-width: 28px; height: 28px; line-height: 28px; text-align: center; background: #1d4ed8; color: #fff; font-weight: 800; border-radius: 8px; font-size: 13px; margin-right: 8px; vertical-align: top; }
    .ej-titulo { font-size: 11px; font-weight: 600; color: #1e40af; margin-bottom: 6px; }
    .operacion-linea { font-size: 14px; font-weight: 600; font-family: 'Consolas', 'Courier New', monospace; margin: 6px 0 6px 36px; letter-spacing: 0.05em; }
    .problema-texto { font-size: 11px; line-height: 1.55; margin: 4px 0 8px 36px; text-align: justify; }
    .espacio-resp { min-height: 52px; margin: 6px 0 4px 36px; border: 2px dashed #94a3b8; border-radius: 8px; background: #fff; }
    .espacio-resp--alto { min-height: 72px; }
    .oracion-completar { font-size: 11.5px; margin: 4px 0 8px 36px; }
    .hueco { display: inline-block; min-width: 70px; border-bottom: 2px solid #64748b; margin: 0 4px; }
    .tabla-vf { width: 100%; border-collapse: collapse; font-size: 10px; margin-top: 6px; }
    .tabla-vf th, .tabla-vf td { border: 1px solid #cbd5e1; padding: 5px 6px; }
    .tabla-vf .vf-col { width: 32px; text-align: center; }
    .tabla-vf .casillero { text-align: center; font-size: 14px; }
    .pie { margin-top: 8px; text-align: center; background: #fef3c7; border: 2px solid #fbbf24; border-radius: 10px; padding: 8px; font-size: 11px; font-weight: 600; color: #92400e; }
    .footer-meta { margin-top: auto; padding: 8px 14px 4px; border-top: 2px solid #e2e8f0; display: flex; justify-content: space-between; font-size: 8.5px; color: #94a3b8; }
    .mascota-inline img { width: 52px; height: auto; }
    @media print {
      .sheet { border: none; min-height: 268mm; page-break-after: always; }
      .hoja-aplicacion.sheet { page-break-after: auto; }
      .ejercicio-math { break-inside: avoid; page-break-inside: avoid; }
    }
  </style>
</head>
<body>
  <div class="sheet hoja-teoria">
    <div class="sheet-top-band"></div>
    <div class="sheet-inner">
      <div class="sheet-body">
        <div class="header">
          <div class="unidad-badge">{{unidad}}</div>
          <div>
            <h1 class="titulo-principal">{{titulo}}</h1>
            <p class="subtitulo">{{subtituloLinea}}</p>
          </div>
          <div style="text-align:right">
            {{#if tieneLogo}}<img class="logo" src="{{logoUrl}}" alt="Vanguard" />{{else}}<div class="logo-text">VANGUARD<br/>Schools</div>{{/if}}
          </div>
        </div>
        <div class="seccion-titulo-wrap"><span>🔢</span><h2>{{teoria.titulo_seccion}}</h2></div>
        {{#each teoria.parrafos}}
        <div class="parrafo-teoria">
          <div class="parrafo-num">{{num}}</div>
          <div>{{texto}}</div>
        </div>
        {{/each}}
        {{#if teoria.recuerda}}
        <div class="recuerda-box">
          <h3>💡 RECUERDA</h3>
          <ul>{{#each teoria.recuerda}}<li>{{this}}</li>{{/each}}</ul>
        </div>
        {{/if}}
      </div>
      <div class="footer-meta"><span>{{area}} · Teoría · Hoja 1</span><span>Vanguard Schools</span></div>
    </div>
  </div>

  <div class="sheet hoja-aplicacion page-break">
    <div class="sheet-top-band"></div>
    <div class="sheet-inner">
      <div class="sheet-body">
        <div class="aplicacion-banner">
          <h2>{{aplicacion.titulo_seccion}}</h2>
          {{#if aplicacion.instruccion_general}}<p>{{aplicacion.instruccion_general}}</p>{{/if}}
        </div>

        {{#each ejerciciosMatematicos}}
        <div class="ejercicio-math">
          <div class="ej-titulo"><span class="ej-num">{{numero}}</span>{{#if enunciado}}{{enunciado}}{{/if}}</div>

          {{#if (eq tipo "operacion")}}
          {{#each operaciones}}
          <div class="operacion-linea">{{this}}</div>
          {{/each}}
          <div class="espacio-resp"></div>
          {{/if}}

          {{#if (eq tipo "problema")}}
          <p class="problema-texto">{{texto}}</p>
          <div class="espacio-resp espacio-resp--alto"></div>
          {{/if}}

          {{#if (eq tipo "completar")}}
          <p class="oracion-completar">{{oracionHtml}}</p>
          {{/if}}

          {{#if (eq tipo "verdadero_falso")}}
          <table class="tabla-vf">
            <thead><tr><th>Affirmación</th><th class="vf-col">V</th><th class="vf-col">F</th></tr></thead>
            <tbody>
              {{#each items}}
              <tr><td>{{enunciado}}</td><td class="casillero">○</td><td class="casillero">○</td></tr>
              {{/each}}
            </tbody>
          </table>
          {{/if}}
        </div>
        {{/each}}

        {{#if pie_motivacional}}<div class="pie">{{pie_motivacional}}</div>{{/if}}
      </div>
      <div class="footer-meta">
        <span>{{area}} · Matemática · Hoja 2</span>
        {{#if usoVanguarcito}}<span>Vanguarcito · Vanguard Schools</span>{{else}}<span>Vanguard Schools</span>{{/if}}
      </div>
    </div>
  </div>
</body>
</html>
